{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "FileEntry": {
        "additionalProperties": false,
        "properties": {
          "group": {
            "description": "Group owning the file; empty where the system has no owners.",
            "type": "string"
          },
          "isDir": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "folder",
              "image",
              "video",
              "audio",
              "text",
              "archive",
              "other"
            ],
            "type": "string"
          },
          "modTime": {
            "format": "date-time",
            "type": "string"
          },
          "mode": {
            "description": "Type and permissions, as ls -l shows them, e.g. -rw-r--r--.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "description": "User owning the file; empty where the system has no owners.",
            "type": "string"
          },
          "path": {
            "description": "Slash-separated path relative to the root folder.",
            "type": "string"
          },
          "size": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "path",
          "isDir",
          "size",
          "modTime",
          "kind",
          "mode",
          "owner",
          "group"
        ],
        "type": "object"
      },
      "Info": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Base name of the root folder.",
            "type": "string"
          },
          "root": {
            "description": "Absolute path of the root folder.",
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "root",
          "name",
          "startedAt"
        ],
        "type": "object"
      },
      "Listing": {
        "additionalProperties": false,
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/FileEntry"
            },
            "type": "array"
          },
          "path": {
            "description": "Path of the folder, \".\" for the root folder itself.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "entries"
        ],
        "type": "object"
      },
      "MkdirRequest": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Path of the new folder.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "MoveRequest": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "SearchResults": {
        "additionalProperties": false,
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/FileEntry"
            },
            "type": "array"
          },
          "indexed": {
            "description": "Number of files and folders in the index.",
            "format": "int64",
            "type": "integer"
          },
          "scannedAt": {
            "description": "End of the last scan of the root folder; zero before the first one.",
            "format": "date-time",
            "type": "string"
          },
          "scanning": {
            "description": "A scan is running, so results may be out of date.",
            "type": "boolean"
          },
          "total": {
            "description": "Number of all matches, of which entries holds up to limit.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "entries",
          "total",
          "indexed",
          "scannedAt",
          "scanning"
        ],
        "type": "object"
      },
      "Uploaded": {
        "additionalProperties": false,
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "just-files API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/files": {
      "delete": {
        "operationId": "deleteFile",
        "parameters": [
          {
            "description": "Slash-separated path relative to the root folder; empty for the root folder itself.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Slash-separated path relative to the root folder; empty for the root folder itself.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Delete a file or folder with its content",
        "tags": [
          "files"
        ]
      },
      "get": {
        "operationId": "listFiles",
        "parameters": [
          {
            "description": "Slash-separated path relative to the root folder; empty for the root folder itself.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Slash-separated path relative to the root folder; empty for the root folder itself.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listing"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List a folder",
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/content": {
      "get": {
        "description": "Supports range requests. Text files are sent as plain text, and nothing sent runs scripts: the browser treats it as sandboxed, except PDFs, which browsers do not show sandboxed.",
        "operationId": "getFileContent",
        "parameters": [
          {
            "description": "Slash-separated path relative to the root folder; empty for the root folder itself.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Slash-separated path relative to the root folder; empty for the root folder itself.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "contentMediaType": "application/octet-stream",
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The file content."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get a file's content to view it in the browser",
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/download": {
      "get": {
        "description": "Supports range requests.",
        "operationId": "downloadFile",
        "parameters": [
          {
            "description": "Slash-separated path relative to the root folder; empty for the root folder itself.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Slash-separated path relative to the root folder; empty for the root folder itself.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "contentMediaType": "application/octet-stream",
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The file content."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Download a file",
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/mkdir": {
      "post": {
        "operationId": "createFolder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MkdirRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileEntry"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Create a folder",
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/move": {
      "post": {
        "operationId": "moveFile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileEntry"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Rename or move a file or folder",
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/upload": {
      "post": {
        "operationId": "uploadFiles",
        "parameters": [
          {
            "description": "Folder to upload into; empty for the root folder itself.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Folder to upload into; empty for the root folder itself.",
              "type": "string"
            }
          },
          {
            "description": "Replace existing files.",
            "explode": false,
            "in": "query",
            "name": "overwrite",
            "schema": {
              "description": "Replace existing files.",
              "type": "boolean"
            }
          },
          {
            "description": "Create the folder and its parents if missing, for uploads of whole folders.",
            "explode": false,
            "in": "query",
            "name": "parents",
            "schema": {
              "description": "Create the folder and its parents if missing, for uploads of whole folders.",
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "items": {
                      "contentMediaType": "application/octet-stream",
                      "format": "binary",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Uploaded"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Upload files into a folder",
        "tags": [
          "files"
        ]
      }
    },
    "/api/info": {
      "get": {
        "operationId": "getInfo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Describe the server and its root folder",
        "tags": [
          "server"
        ]
      }
    },
    "/api/search": {
      "get": {
        "description": "Searches an in-memory index of the root folder, which is refreshed periodically and after changes made through the API.",
        "operationId": "search",
        "parameters": [
          {
            "description": "Space-separated terms that must all be part of a name, ignoring case.",
            "explode": false,
            "in": "query",
            "name": "q",
            "schema": {
              "description": "Space-separated terms that must all be part of a name, ignoring case.",
              "type": "string"
            }
          },
          {
            "description": "Folder to search in; empty for the root folder.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Folder to search in; empty for the root folder.",
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 200,
              "format": "int64",
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResults"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Search files and folders by name",
        "tags": [
          "files"
        ]
      }
    }
  }
}
